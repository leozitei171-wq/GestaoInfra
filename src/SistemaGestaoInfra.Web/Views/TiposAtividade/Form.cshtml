@model TipoAtividadeViewModel
@{
    var acao = Model.EhNovo ? "Novo" : "Editar";
}

<div class="card mx-auto" style="max-width: 620px">
    <div class="card-header">@(Model.EhNovo ? "Cadastrar tipo de atividade" : $"Editando: {Model.Codigo}")</div>
    <div class="card-body">
        <form asp-action="@acao" asp-route-id="@Model.Id" method="post" novalidate>
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>

            <div class="mb-3">
                <label asp-for="Codigo" class="form-label"></label>
                <input asp-for="Codigo" class="form-control text-uppercase" autocomplete="off" aria-describedby="ajudaCodigo" />
                <div id="ajudaCodigo" class="form-text">Sigla curta, ex: CEC, TB, CLC.</div>
                <span asp-validation-for="Codigo" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Descricao" class="form-label"></label>
                <input asp-for="Descricao" class="form-control" autocomplete="off" />
                <span asp-validation-for="Descricao" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="SetorId" class="form-label"></label>
                <select asp-for="SetorId" asp-items="Model.Setores" class="form-select" aria-describedby="ajudaSetor">
                    <option value="">Sem setor definido</option>
                </select>
                <div id="ajudaSetor" class="form-text">Ao registrar uma atividade deste tipo, o setor é sugerido automaticamente.</div>
                <span asp-validation-for="SetorId" class="text-danger small"></span>
            </div>

            <div class="form-check form-switch mb-4">
                <input asp-for="Ativo" class="form-check-input" role="switch" />
                <label asp-for="Ativo" class="form-check-label">Ativo (disponível para seleção)</label>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1" aria-hidden="true"></i>Salvar</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
