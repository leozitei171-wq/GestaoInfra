@using SistemaGestaoInfra.Web.Controllers
@model IReadOnlyList<ContratoLista>
@{
    var pt = System.Globalization.CultureInfo.GetCultureInfo("pt-BR");
    var hoje = DateOnly.FromDateTime(DateTime.Now);
    string CorUso(decimal p) => p >= 100 ? "bg-danger" : p >= 80 ? "bg-warning" : "bg-success";
}

<div class="card">
    <div class="card-header d-flex align-items-center">
        <span class="me-auto">@Model.Count contrato(s)</span>
        <a asp-action="Novo" class="btn btn-primary"><i class="bi bi-plus-lg me-1" aria-hidden="true"></i>Novo contrato</a>
    </div>

    @if (Model.Count == 0)
    {
        <div class="card-body text-center text-muted py-5">Nenhum contrato cadastrado.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th scope="col">Contrato</th>
                        <th scope="col">Fornecedor</th>
                        <th scope="col">Vigência</th>
                        <th scope="col" class="text-end">Valor total</th>
                        <th scope="col" style="min-width:150px">Uso</th>
                        <th scope="col">Situação</th>
                        <th scope="col" class="text-end">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model)
                    {
                        var vencido = c.DataFim < hoje;
                        <tr class="@(c.Ativo ? "" : "text-muted")">
                            <td>
                                <a asp-action="Detalhe" asp-route-id="@c.Id" class="fw-semibold text-decoration-none">@c.Codigo</a>
                                <div class="small text-muted text-truncate" style="max-width:240px">@c.Descricao</div>
                            </td>
                            <td>@c.Fornecedor</td>
                            <td class="text-nowrap">
                                @c.DataInicio.ToString("dd/MM/yyyy") – @c.DataFim.ToString("dd/MM/yyyy")
                                @if (vencido) { <span class="badge text-bg-secondary ms-1">encerrado</span> }
                            </td>
                            <td class="text-end text-nowrap">@c.ValorTotal.ToString("C2", pt)</td>
                            <td>
                                <div class="progress" role="progressbar" aria-label="Uso do contrato @c.Codigo"
                                     aria-valuenow="@Math.Min(c.PercentualUso, 100)" aria-valuemin="0" aria-valuemax="100" style="height:8px">
                                    <div class="progress-bar @CorUso(c.PercentualUso)" style="width:@(Math.Min(c.PercentualUso, 100).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))%"></div>
                                </div>
                                <small class="text-muted">@c.PercentualUso.ToString("0.##", pt)%</small>
                            </td>
                            <td><span class="badge @(c.Ativo ? "text-bg-success" : "text-bg-secondary")">@(c.Ativo ? "Ativo" : "Inativo")</span></td>
                            <td class="text-end text-nowrap">
                                <a asp-action="Detalhe" asp-route-id="@c.Id" class="btn btn-sm btn-outline-secondary">Ver</a>
                                <a asp-action="Editar" asp-route-id="@c.Id" class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil" aria-hidden="true"></i></a>
                                <form asp-action="Excluir" asp-route-id="@c.Id" method="post" class="d-inline"
                                      onsubmit="return confirm('Excluir o contrato @c.Codigo?');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger" aria-label="Excluir contrato @c.Codigo"><i class="bi bi-trash" aria-hidden="true"></i></button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
