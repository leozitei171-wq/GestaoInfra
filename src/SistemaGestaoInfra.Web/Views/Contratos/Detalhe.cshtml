@using SistemaGestaoInfra.Web.Controllers
@model ContratoDetalheViewModel
@{
    var pt = System.Globalization.CultureInfo.GetCultureInfo("pt-BR");
    var inv = System.Globalization.CultureInfo.InvariantCulture;
    string CorUso(decimal p) => p >= 100 ? "bg-danger" : p >= 80 ? "bg-warning" : "bg-success";
}

<div class="row g-3 mb-3">
    <div class="col-lg-8">
        <div class="card h-100">
            <div class="card-header d-flex align-items-center">
                <span class="me-auto">Contrato @Model.Codigo</span>
                <span class="badge @(Model.Ativo ? "text-bg-success" : "text-bg-secondary")">@(Model.Ativo ? "Ativo" : "Inativo")</span>
            </div>
            <div class="card-body">
                <p>@Model.Descricao</p>
                <dl class="row mb-0">
                    <dt class="col-sm-4">Fornecedor</dt><dd class="col-sm-8">@Model.Fornecedor</dd>
                    <dt class="col-sm-4">Setor</dt><dd class="col-sm-8">@(Model.Setor ?? "—")</dd>
                    <dt class="col-sm-4">Vigência</dt>
                    <dd class="col-sm-8">
                        @Model.DataInicio.ToString("dd/MM/yyyy") a @Model.DataFim.ToString("dd/MM/yyyy")
                        @if (Model.DiasParaVencer < 0) { <span class="badge text-bg-secondary ms-1">encerrado</span> }
                        else if (Model.DiasParaVencer <= 30) { <span class="badge text-bg-warning ms-1">vence em @Model.DiasParaVencer dia(s)</span> }
                    </dd>
                    <dt class="col-sm-4">PDF</dt>
                    <dd class="col-sm-8">
                        @if (Model.TemPdf) { <a asp-action="Pdf" asp-route-id="@Model.Id" target="_blank" rel="noopener"><i class="bi bi-file-earmark-pdf" aria-hidden="true"></i> Abrir PDF</a> }
                        else { <span class="text-muted">não anexado</span> }
                    </dd>
                </dl>
            </div>
            <div class="card-footer d-flex gap-2">
                <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1" aria-hidden="true"></i>Voltar</a>
                <a asp-action="Editar" asp-route-id="@Model.Id" class="btn btn-primary"><i class="bi bi-pencil me-1" aria-hidden="true"></i>Editar</a>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card h-100">
            <div class="card-header">Consumo do contrato</div>
            <div class="card-body">
                <div class="zt-stat-value">@Model.PercentualUso.ToString("0.##", pt)%</div>
                <div class="progress my-2" role="progressbar" aria-label="Uso do contrato"
                     aria-valuenow="@Math.Min(Model.PercentualUso, 100)" aria-valuemin="0" aria-valuemax="100" style="height:10px">
                    <div class="progress-bar @CorUso(Model.PercentualUso)" style="width:@(Math.Min(Model.PercentualUso, 100).ToString("0.##", inv))%"></div>
                </div>
                <div class="small text-muted">@Model.Consumido.ToString("C2", pt) de @Model.ValorTotal.ToString("C2", pt)</div>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header">Serviços contratados</div>
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th scope="col">Serviço</th>
                    <th scope="col">Medição</th>
                    <th scope="col" class="text-end">Contratado</th>
                    <th scope="col" class="text-end">Unitário</th>
                    <th scope="col" class="text-end">Limite</th>
                    <th scope="col" class="text-end">Executado</th>
                    <th scope="col" class="text-end">Valor do item</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var i in Model.Itens)
                {
                    <tr>
                        <td>@i.Servico</td>
                        <td>@i.Medicao</td>
                        <td class="text-end">@i.Quantidade.ToString("0.####", pt)</td>
                        <td class="text-end">@i.ValorUnitario.ToString("C2", pt)</td>
                        <td class="text-end">@(i.Limite?.ToString("0.####", pt) ?? "—")</td>
                        <td class="text-end">@i.Executado.ToString("0.####", pt) <small class="text-muted">(@i.PercentualUso.ToString("0.#", pt)%)</small></td>
                        <td class="text-end">@i.ValorItem.ToString("C2", pt)</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr><th colspan="6" class="text-end">Valor total</th><th class="text-end">@Model.ValorTotal.ToString("C2", pt)</th></tr>
            </tfoot>
        </table>
    </div>
</div>
