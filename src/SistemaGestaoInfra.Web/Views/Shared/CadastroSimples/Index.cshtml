@using SistemaGestaoInfra.Domain.Common
@model IReadOnlyList<ICadastroSimples>
@{
    var singular = (string)ViewData["TituloSingular"]!;
}

<div class="card">
    <div class="card-header d-flex align-items-center">
        <span class="me-auto">@Model.Count registro(s)</span>
        <a asp-action="Novo" class="btn btn-primary"><i class="bi bi-plus-lg me-1" aria-hidden="true"></i>Novo(a) @singular.ToLowerInvariant()</a>
    </div>

    @if (Model.Count == 0)
    {
        <div class="card-body text-center text-muted py-5">Nenhum registro cadastrado.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th scope="col">Código</th>
                        <th scope="col">Descrição</th>
                        <th scope="col">Situação</th>
                        <th scope="col" class="text-end">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var i in Model)
                    {
                        <tr class="@(i.Ativo ? "" : "text-muted")">
                            <td><code>@i.Codigo</code></td>
                            <td>@i.Descricao</td>
                            <td><span class="badge @(i.Ativo ? "text-bg-success" : "text-bg-secondary")">@(i.Ativo ? "Ativo" : "Inativo")</span></td>
                            <td class="text-end text-nowrap">
                                <a asp-action="Editar" asp-route-id="@i.Id" class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil" aria-hidden="true"></i> Editar</a>
                                <form asp-action="Excluir" asp-route-id="@i.Id" method="post" class="d-inline"
                                      onsubmit="return confirm('Excluir @i.Codigo?');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash" aria-hidden="true"></i> Excluir</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
