<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] is string titulo ? $"{titulo} — Zitei" : "Zitei")</title>
    <link rel="icon" type="image/svg+xml" href="~/img/zitei-logo.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Public+Sans:wght@400;500;600;700;800&display=swap" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <a class="visually-hidden-focusable position-absolute top-0 start-0 p-2 bg-white" href="#conteudo">Pular para o conteúdo</a>

    <header class="bg-white border-bottom">
        <div class="container py-2 d-flex align-items-center gap-3">
            <a asp-controller="Transparencia" asp-action="Index" class="zt-brand text-decoration-none" style="color:var(--zt-primary-dark)">
                <img src="~/img/zitei-logo.svg" alt="" class="zt-logo" />
                <span>
                    <span class="zt-brand-name" style="color:var(--zt-primary-dark)">Zitei</span>
                    <span class="zt-brand-tagline text-muted">Transparência</span>
                </span>
            </a>
            <a asp-controller="Conta" asp-action="Login" class="btn btn-outline-primary btn-sm ms-auto">
                <i class="bi bi-box-arrow-in-right me-1" aria-hidden="true"></i>Entrar no sistema
            </a>
        </div>
    </header>

    <main class="container py-4" id="conteudo" tabindex="-1">
        @RenderBody()
    </main>

    <footer class="container py-3 text-muted small">
        Visão pública: sem identificação de quem registrou a demanda e sem fotos. Informações pessoais eventualmente
        digitadas na descrição são ocultadas.
        <span class="d-block">&copy; @DateTime.Now.Year <strong>Zitei</strong></span>
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
