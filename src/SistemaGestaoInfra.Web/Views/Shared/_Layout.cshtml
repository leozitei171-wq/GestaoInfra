<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] is string titulo ? $"{titulo} — Zitei" : "Zitei")</title>
    <link rel="icon" type="image/svg+xml" href="~/img/zitei-logo.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Public+Sans:wght@400;500;600;700;800&display=swap" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <a class="visually-hidden-focusable position-absolute top-0 start-0 p-2 bg-white" href="#conteudo">Pular para o conteúdo</a>

    <partial name="_Sidebar" />

    @{
        var nome = User.FindFirstValue(AppClaimsPrincipalFactory.ClaimNome) ?? User.Identity?.Name ?? "Usuário";
        var perfil = User.FindFirstValue(TenantProvider.ClaimPerfil) ?? string.Empty;
        var iniciais = string.Concat(nome.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(p => char.ToUpperInvariant(p[0])));
    }

    <div class="zt-main">
        <header class="zt-topbar">
            <button type="button" class="btn btn-light d-lg-none" id="zt-toggle-sidebar"
                    aria-controls="zt-sidebar" aria-expanded="false" aria-label="Abrir menu">
                <i class="bi bi-list fs-5" aria-hidden="true"></i>
            </button>

            <h1 class="h5 mb-0 fw-semibold text-truncate">@ViewData["Title"]</h1>

            <div class="dropdown ms-auto">
                <button class="btn btn-link text-decoration-none d-flex align-items-center gap-2 p-0" type="button"
                        data-bs-toggle="dropdown" aria-expanded="false" aria-label="Menu do usuário">
                    <span class="text-end d-none d-md-block lh-sm">
                        <span class="d-block fw-semibold text-dark">@nome</span>
                        <small class="text-muted">@perfil</small>
                    </span>
                    <span class="zt-avatar" aria-hidden="true">@iniciais</span>
                </button>
                <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                    <li><span class="dropdown-item-text small text-muted">Conectado como <strong>@User.Identity?.Name</strong></span></li>
                    <li><hr class="dropdown-divider" /></li>
                    <li>
                        <form asp-controller="Conta" asp-action="Logout" method="post">
                            <button type="submit" class="dropdown-item text-danger">
                                <i class="bi bi-box-arrow-right me-2" aria-hidden="true"></i>Sair
                            </button>
                        </form>
                    </li>
                </ul>
            </div>
        </header>

        <main class="zt-content" id="conteudo" tabindex="-1">
            @if (TempData["Sucesso"] is string sucesso)
            {
                <div class="alert alert-success alert-dismissible fade show" role="status">
                    @sucesso
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
                </div>
            }
            @if (TempData["Erro"] is string erro)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @erro
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
                </div>
            }

            @RenderBody()
        </main>

        <footer class="zt-footer">
            &copy; @DateTime.Now.Year <strong>Zitei</strong> — Sistema de Gestão de Apontamentos e Custos
        </footer>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
