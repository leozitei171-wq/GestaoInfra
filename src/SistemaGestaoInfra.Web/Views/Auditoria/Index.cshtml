@using SistemaGestaoInfra.Web.Controllers
@model AuditoriaViewModel
@{
    var f = Model.Filtro;

    Dictionary<string, string?> RotaPagina(int pagina) => new()
    {
        ["Entidade"] = f.Entidade,
        ["Acao"] = f.Acao,
        ["Usuario"] = f.Usuario,
        ["De"] = f.De?.ToString("yyyy-MM-dd"),
        ["Ate"] = f.Ate?.ToString("yyyy-MM-dd"),
        ["Pagina"] = pagina.ToString()
    };

    string CorAcao(string acao) => acao switch
    {
        "Criou" => "text-bg-success",
        "Alterou" => "text-bg-primary",
        "Excluiu" => "text-bg-danger",
        "LoginFalhou" or "LoginBloqueado" => "text-bg-warning",
        _ => "text-bg-secondary"
    };
}

<div class="card mb-3">
    <div class="card-body">
        <form method="get" role="search" class="row g-2 align-items-end">
            <div class="col-6 col-lg-2">
                <label for="Entidade" class="form-label small mb-1">Entidade</label>
                <select id="Entidade" name="Entidade" asp-items="Model.Entidades" class="form-select form-select-sm">
                    <option value="">Todas</option>
                </select>
            </div>
            <div class="col-6 col-lg-2">
                <label for="Acao" class="form-label small mb-1">Ação (contém)</label>
                <input id="Acao" name="Acao" value="@f.Acao" class="form-control form-control-sm" placeholder="ex: Alterou" />
            </div>
            <div class="col-6 col-lg-3">
                <label for="Usuario" class="form-label small mb-1">Usuário</label>
                <input id="Usuario" name="Usuario" value="@f.Usuario" class="form-control form-control-sm" />
            </div>
            <div class="col-6 col-lg-2">
                <label for="De" class="form-label small mb-1">De</label>
                <input type="date" id="De" name="De" value="@f.De?.ToString("yyyy-MM-dd")" class="form-control form-control-sm" />
            </div>
            <div class="col-6 col-lg-2">
                <label for="Ate" class="form-label small mb-1">Até</label>
                <input type="date" id="Ate" name="Ate" value="@f.Ate?.ToString("yyyy-MM-dd")" class="form-control form-control-sm" />
            </div>
            <div class="col-6 col-lg-1 d-flex gap-1">
                <button type="submit" class="btn btn-sm btn-primary flex-grow-1" aria-label="Filtrar"><i class="bi bi-funnel" aria-hidden="true"></i></button>
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary" aria-label="Limpar"><i class="bi bi-x-lg" aria-hidden="true"></i></a>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-header">@Model.Total registro(s) de auditoria</div>

    @if (Model.Itens.Count == 0)
    {
        <div class="card-body text-center text-muted py-5">Nenhum registro encontrado.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-sm table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th scope="col">Quando</th>
                        <th scope="col">Usuário</th>
                        <th scope="col">Ação</th>
                        <th scope="col">Entidade</th>
                        <th scope="col">Id</th>
                        <th scope="col">Modo</th>
                        <th scope="col">IP</th>
                        <th scope="col">Payload</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var a in Model.Itens)
                    {
                        <tr>
                            <td class="text-nowrap">@a.QuandoEm.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")</td>
                            <td>@(a.UsuarioNome ?? "—")</td>
                            <td><span class="badge @CorAcao(a.Acao)">@a.Acao</span></td>
                            <td>@a.Entidade</td>
                            <td class="text-nowrap">@(a.EntidadeId ?? "—")</td>
                            <td>@a.Modo</td>
                            <td class="text-nowrap">@(a.Ip ?? "—")</td>
                            <td style="max-width:360px">
                                @if (string.IsNullOrEmpty(a.Payload))
                                {
                                    <span class="text-muted">—</span>
                                }
                                else
                                {
                                    <details>
                                        <summary class="small text-primary" style="cursor:pointer">ver detalhes</summary>
                                        <pre class="small mb-0 mt-1 bg-light p-2 rounded" style="white-space:pre-wrap;word-break:break-word">@a.Payload</pre>
                                    </details>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Model.TotalPaginas > 1)
        {
            <nav class="card-footer d-flex justify-content-between align-items-center" aria-label="Paginação">
                <small class="text-muted">Página @f.Pagina de @Model.TotalPaginas</small>
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(f.Pagina <= 1 ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-all-route-data="@RotaPagina(f.Pagina - 1)">Anterior</a>
                    </li>
                    <li class="page-item @(f.Pagina >= Model.TotalPaginas ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-all-route-data="@RotaPagina(f.Pagina + 1)">Próxima</a>
                    </li>
                </ul>
            </nav>
        }
    }
</div>
