@model IReadOnlyList<SistemaGestaoInfra.Domain.Entities.Prioridade>

<div class="card">
    <div class="card-header d-flex align-items-center">
        <span class="me-auto">@Model.Count prioridade(s) cadastrada(s)</span>
        <a asp-action="Novo" class="btn btn-primary"><i class="bi bi-plus-lg me-1" aria-hidden="true"></i>Nova prioridade</a>
    </div>

    @if (Model.Count == 0)
    {
        <div class="card-body text-center text-muted py-5">Nenhuma prioridade cadastrada.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th scope="col" style="width:90px">Ordem</th>
                        <th scope="col">Código</th>
                        <th scope="col">Descrição</th>
                        <th scope="col">Situação</th>
                        <th scope="col" class="text-end">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model)
                    {
                        <tr class="@(p.Ativo ? "" : "text-muted")">
                            <td>@p.Ordem</td>
                            <td><code>@p.Codigo</code></td>
                            <td>@p.Descricao</td>
                            <td>
                                <span class="badge @(p.Ativo ? "text-bg-success" : "text-bg-secondary")">
                                    @(p.Ativo ? "Ativa" : "Inativa")
                                </span>
                            </td>
                            <td class="text-end text-nowrap">
                                <a asp-action="Editar" asp-route-id="@p.Id" class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-pencil" aria-hidden="true"></i> Editar
                                </a>
                                <form asp-action="Excluir" asp-route-id="@p.Id" method="post" class="d-inline"
                                      onsubmit="return confirm('Excluir a prioridade @p.Codigo?');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                        <i class="bi bi-trash" aria-hidden="true"></i> Excluir
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
