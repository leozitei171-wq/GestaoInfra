@using SistemaGestaoInfra.Domain.Common
@model IReadOnlyList<SistemaGestaoInfra.Domain.Entities.Fornecedor>

<div class="card">
    <div class="card-header d-flex align-items-center">
        <span class="me-auto">@Model.Count fornecedor(es)</span>
        <a asp-action="Novo" class="btn btn-primary"><i class="bi bi-plus-lg me-1" aria-hidden="true"></i>Novo fornecedor</a>
    </div>

    @if (Model.Count == 0)
    {
        <div class="card-body text-center text-muted py-5">Nenhum fornecedor cadastrado.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th scope="col">Razão social</th>
                        <th scope="col">CNPJ</th>
                        <th scope="col">Contato</th>
                        <th scope="col">Situação</th>
                        <th scope="col" class="text-end">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var f in Model)
                    {
                        <tr class="@(f.Ativo ? "" : "text-muted")">
                            <td class="fw-semibold">@f.RazaoSocial</td>
                            <td class="text-nowrap">@Cnpj.Formatar(f.Cnpj)</td>
                            <td>@(f.Contato ?? "—")</td>
                            <td><span class="badge @(f.Ativo ? "text-bg-success" : "text-bg-secondary")">@(f.Ativo ? "Ativo" : "Inativo")</span></td>
                            <td class="text-end text-nowrap">
                                <a asp-action="Editar" asp-route-id="@f.Id" class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil" aria-hidden="true"></i> Editar</a>
                                <form asp-action="Excluir" asp-route-id="@f.Id" method="post" class="d-inline"
                                      onsubmit="return confirm('Excluir o fornecedor?');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash" aria-hidden="true"></i> Excluir</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
