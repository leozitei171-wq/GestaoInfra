@model IReadOnlyList<UsuarioListaItem>
@{
    var busca = ViewData["Busca"] as string;
    var idAtual = User.FindFirstValue(ClaimTypes.NameIdentifier);
    string CorPerfil(PerfilUsuario p) => p switch
    {
        PerfilUsuario.Admin => "text-bg-dark",
        PerfilUsuario.Gestor => "text-bg-primary",
        PerfilUsuario.Servidor => "text-bg-info",
        PerfilUsuario.Vereador => "text-bg-warning",
        _ => "text-bg-secondary"
    };
}

<div class="card">
    <div class="card-header d-flex flex-wrap gap-2 align-items-center">
        <form method="get" class="d-flex gap-2 me-auto" role="search">
            <label for="busca" class="visually-hidden">Buscar usuário</label>
            <input type="search" id="busca" name="busca" value="@busca" class="form-control" placeholder="Nome, login ou e-mail" />
            <button type="submit" class="btn btn-outline-primary"><i class="bi bi-search" aria-hidden="true"></i><span class="visually-hidden">Buscar</span></button>
        </form>
        <a asp-action="Novo" class="btn btn-primary"><i class="bi bi-person-plus me-1" aria-hidden="true"></i>Novo usuário</a>
    </div>

    @if (Model.Count == 0)
    {
        <div class="card-body text-center text-muted py-5">Nenhum usuário encontrado.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th scope="col">Nome</th>
                        <th scope="col">Login</th>
                        <th scope="col">Perfil</th>
                        <th scope="col">Prefeitura</th>
                        <th scope="col">Situação</th>
                        <th scope="col" class="text-end">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var u in Model)
                    {
                        <tr class="@(u.Ativo ? "" : "text-muted")">
                            <td>
                                <div class="fw-semibold">@u.NomeCompleto</div>
                                <small class="text-muted">@u.Email</small>
                            </td>
                            <td>@u.Login</td>
                            <td><span class="badge @CorPerfil(u.Perfil)">@u.Perfil</span></td>
                            <td>@(u.Prefeitura ?? "—")</td>
                            <td>
                                @if (u.Ativo)
                                {
                                    <span class="badge text-bg-success">Ativo</span>
                                }
                                else
                                {
                                    <span class="badge text-bg-secondary">Inativo</span>
                                }
                            </td>
                            <td class="text-end text-nowrap">
                                <a asp-action="Editar" asp-route-id="@u.Id" class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-pencil" aria-hidden="true"></i> Editar
                                </a>
                                @if (u.Id != idAtual)
                                {
                                    <form asp-action="AlternarAtivo" asp-route-id="@u.Id" method="post" class="d-inline">
                                        <button type="submit" class="btn btn-sm @(u.Ativo ? "btn-outline-danger" : "btn-outline-success")">
                                            @(u.Ativo ? "Desativar" : "Ativar")
                                        </button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
