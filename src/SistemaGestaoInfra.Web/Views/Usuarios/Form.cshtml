@model UsuarioFormViewModel
@{
    var acao = Model.EhNovo ? "Novo" : "Editar";
    var perfis = Html.GetEnumSelectList<PerfilUsuario>();
}

<div class="card mx-auto" style="max-width: 760px">
    <div class="card-header">@(Model.EhNovo ? "Cadastrar usuário" : $"Editando: {Model.NomeCompleto}")</div>
    <div class="card-body">
        <form asp-action="@acao" asp-route-id="@Model.Id" method="post" novalidate>
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>

            <div class="mb-3">
                <label asp-for="NomeCompleto" class="form-label"></label>
                <input asp-for="NomeCompleto" class="form-control" autocomplete="name" />
                <span asp-validation-for="NomeCompleto" class="text-danger small"></span>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-md-5">
                    <label asp-for="Login" class="form-label"></label>
                    <input asp-for="Login" class="form-control" autocomplete="off" />
                    <span asp-validation-for="Login" class="text-danger small"></span>
                </div>
                <div class="col-md-7">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" type="email" class="form-control" autocomplete="off" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-md-7">
                    <label asp-for="PrefeituraId" class="form-label"></label>
                    <select asp-for="PrefeituraId" asp-items="Model.Prefeituras" class="form-select">
                        <option value="">Selecione…</option>
                    </select>
                    <span asp-validation-for="PrefeituraId" class="text-danger small"></span>
                </div>
                <div class="col-md-5">
                    <label asp-for="Perfil" class="form-label"></label>
                    <select asp-for="Perfil" asp-items="perfis" class="form-select"></select>
                    <span asp-validation-for="Perfil" class="text-danger small"></span>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Senha" class="form-label">
                    @(Model.EhNovo ? "Senha inicial" : "Nova senha")
                </label>
                <input asp-for="Senha" class="form-control" autocomplete="new-password" aria-describedby="ajudaSenha" />
                <div id="ajudaSenha" class="form-text">
                    @(Model.EhNovo ? "Mínimo de 8 caracteres, com letra maiúscula, minúscula e número." : "Deixe em branco para manter a senha atual.")
                </div>
                <span asp-validation-for="Senha" class="text-danger small"></span>
            </div>

            <div class="form-check form-switch mb-4">
                <input asp-for="Ativo" class="form-check-input" role="switch" />
                <label asp-for="Ativo" class="form-check-label">Usuário ativo (pode fazer login)</label>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1" aria-hidden="true"></i>Salvar</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
