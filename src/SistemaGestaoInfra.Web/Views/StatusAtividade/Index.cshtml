@using SistemaGestaoInfra.Domain.Common
@model IReadOnlyList<SistemaGestaoInfra.Domain.Entities.StatusAtividade>

<div class="card">
    <div class="card-header d-flex align-items-center">
        <span class="me-auto">@Model.Count status cadastrado(s)</span>
        <a asp-action="Novo" class="btn btn-primary"><i class="bi bi-plus-lg me-1" aria-hidden="true"></i>Novo status</a>
    </div>

    <div class="card-body pb-0">
        <p class="text-muted small mb-3">
            <i class="bi bi-info-circle me-1" aria-hidden="true"></i>
            Status marcados como <strong>padrão</strong> sustentam regras do sistema (dashboard, controle de
            atrasos e cores do mapa): você pode ajustar descrição e cor, mas não o código.
        </p>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th scope="col">Cor</th>
                    <th scope="col">Código</th>
                    <th scope="col">Descrição</th>
                    <th scope="col">Tipo</th>
                    <th scope="col">Situação</th>
                    <th scope="col" class="text-end">Ações</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in Model)
                {
                    var padrao = StatusCodigos.EhReservado(s.Codigo);
                    <tr class="@(s.Ativo ? "" : "text-muted")">
                        <td>
                            <span class="zt-status-dot" style="background:@s.Cor;width:1.1rem;height:1.1rem" aria-hidden="true"></span>
                            <small class="text-muted">@s.Cor</small>
                        </td>
                        <td><code>@s.Codigo</code></td>
                        <td>@s.Descricao</td>
                        <td>
                            @if (padrao)
                            {
                                <span class="badge text-bg-dark">Padrão</span>
                            }
                            else
                            {
                                <span class="badge text-bg-light border">Personalizado</span>
                            }
                        </td>
                        <td>
                            <span class="badge @(s.Ativo ? "text-bg-success" : "text-bg-secondary")">
                                @(s.Ativo ? "Ativo" : "Inativo")
                            </span>
                        </td>
                        <td class="text-end text-nowrap">
                            <a asp-action="Editar" asp-route-id="@s.Id" class="btn btn-sm btn-outline-primary">
                                <i class="bi bi-pencil" aria-hidden="true"></i> Editar
                            </a>
                            @if (!padrao)
                            {
                                <form asp-action="Excluir" asp-route-id="@s.Id" method="post" class="d-inline"
                                      onsubmit="return confirm('Excluir o status @s.Codigo?');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                        <i class="bi bi-trash" aria-hidden="true"></i> Excluir
                                    </button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
