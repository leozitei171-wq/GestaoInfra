@model AtividadeListaViewModel
@{
    var f = Model.Filtro;

    // Mantém os filtros ao navegar entre páginas.
    Dictionary<string, string?> RotaPagina(int pagina) => new()
    {
        ["Busca"] = f.Busca,
        ["StatusId"] = f.StatusId?.ToString(),
        ["TipoAtividadeId"] = f.TipoAtividadeId?.ToString(),
        ["PrioridadeId"] = f.PrioridadeId?.ToString(),
        ["De"] = f.De?.ToString("yyyy-MM-dd"),
        ["Ate"] = f.Ate?.ToString("yyyy-MM-dd"),
        ["Pagina"] = pagina.ToString()
    };
}

<div class="card mb-3">
    <div class="card-body">
        <form method="get" role="search" class="row g-2 align-items-end">
            <div class="col-12 col-lg-3">
                <label for="Busca" class="form-label small mb-1">Buscar</label>
                <input type="search" id="Busca" name="Busca" value="@f.Busca" class="form-control" placeholder="Descrição, rua ou bairro" />
            </div>
            <div class="col-6 col-lg-2">
                <label for="StatusId" class="form-label small mb-1">Status</label>
                <select id="StatusId" name="StatusId" asp-items="Model.Status" class="form-select">
                    <option value="">Todos</option>
                </select>
            </div>
            <div class="col-6 col-lg-2">
                <label for="TipoAtividadeId" class="form-label small mb-1">Tipo</label>
                <select id="TipoAtividadeId" name="TipoAtividadeId" asp-items="Model.Tipos" class="form-select">
                    <option value="">Todos</option>
                </select>
            </div>
            <div class="col-6 col-lg-2">
                <label for="PrioridadeId" class="form-label small mb-1">Prioridade</label>
                <select id="PrioridadeId" name="PrioridadeId" asp-items="Model.Prioridades" class="form-select">
                    <option value="">Todas</option>
                </select>
            </div>
            <div class="col-6 col-lg-1">
                <label for="De" class="form-label small mb-1">De</label>
                <input type="date" id="De" name="De" value="@f.De?.ToString("yyyy-MM-dd")" class="form-control px-2" />
            </div>
            <div class="col-6 col-lg-1">
                <label for="Ate" class="form-label small mb-1">Até</label>
                <input type="date" id="Ate" name="Ate" value="@f.Ate?.ToString("yyyy-MM-dd")" class="form-control px-2" />
            </div>
            <div class="col-6 col-lg-1 d-flex gap-1">
                <button type="submit" class="btn btn-primary flex-grow-1" aria-label="Filtrar"><i class="bi bi-funnel" aria-hidden="true"></i></button>
                <a asp-action="Index" class="btn btn-outline-secondary" aria-label="Limpar filtros"><i class="bi bi-x-lg" aria-hidden="true"></i></a>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-header d-flex align-items-center">
        <span class="me-auto">@Model.Total atividade(s)</span>
        <a asp-action="Nova" class="btn btn-primary"><i class="bi bi-plus-lg me-1" aria-hidden="true"></i>Nova atividade</a>
    </div>

    @if (Model.Itens.Count == 0)
    {
        <div class="card-body text-center text-muted py-5">
            <i class="bi bi-inbox fs-1 d-block mb-2" aria-hidden="true"></i>
            Nenhuma atividade encontrada.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th scope="col">#</th>
                        <th scope="col">Descrição</th>
                        <th scope="col">Tipo</th>
                        <th scope="col">Setor</th>
                        <th scope="col">Status</th>
                        <th scope="col">Prior.</th>
                        <th scope="col" style="min-width:110px">Progresso</th>
                        <th scope="col" class="text-center">Foto</th>
                        <th scope="col">Abertura</th>
                        <th scope="col"><span class="visually-hidden">Ações</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var a in Model.Itens)
                    {
                        <tr>
                            <td>@a.Id</td>
                            <td class="text-truncate" style="max-width:260px">@a.Descricao</td>
                            <td><span class="badge text-bg-light border">@a.Tipo</span></td>
                            <td>@(a.Setor ?? "—")</td>
                            <td class="text-nowrap"><span class="zt-status-dot" style="background:@a.CorStatus" aria-hidden="true"></span>@a.Status</td>
                            <td>@a.Prioridade</td>
                            <td>
                                <div class="progress" role="progressbar" aria-label="Progresso da atividade @a.Id"
                                     aria-valuenow="@a.Progresso" aria-valuemin="0" aria-valuemax="100" style="height:8px">
                                    <div class="progress-bar" style="width:@a.Progresso%"></div>
                                </div>
                                <small class="text-muted">@a.Progresso%</small>
                            </td>
                            <td class="text-center">
                                @if (a.TemFoto)
                                {
                                    <i class="bi bi-camera-fill text-primary" title="Possui foto" aria-hidden="true"></i>
                                    <span class="visually-hidden">Possui foto</span>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td class="text-nowrap">@a.CriadoEm.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                            <td class="text-end">
                                <a asp-action="Detalhe" asp-route-id="@a.Id" class="btn btn-sm btn-outline-primary">Ver</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Model.TotalPaginas > 1)
        {
            <nav class="card-footer d-flex justify-content-between align-items-center" aria-label="Paginação">
                <small class="text-muted">Página @f.Pagina de @Model.TotalPaginas</small>
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(f.Pagina <= 1 ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-all-route-data="@RotaPagina(f.Pagina - 1)">Anterior</a>
                    </li>
                    <li class="page-item @(f.Pagina >= Model.TotalPaginas ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-all-route-data="@RotaPagina(f.Pagina + 1)">Próxima</a>
                    </li>
                </ul>
            </nav>
        }
    }
</div>
