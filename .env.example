# Copie para ".env" e ajuste. O ".env" NÃO deve ser commitado (já está no .gitignore).
#   cp .env.example .env     (Windows: copy .env.example .env)

# ---- Banco de dados ----
SGI_DB_NAME=sistema_gestao_infra
SGI_DB_USER=sgi
# Troque por uma senha forte em qualquer ambiente que não seja o seu computador.
SGI_DB_PASSWORD=troque-esta-senha

# ---- Aplicação ----
# Porta publicada no host (acesse http://localhost:8080).
SGI_WEB_PORT=8080

# Senha do usuário "admin", usada SOMENTE na primeira inicialização (quando o admin ainda não existe).
# Mínimo de 8 caracteres. Obrigatória fora do ambiente de desenvolvimento.
SGI_ADMIN_PASSWORD=troque-esta-senha-do-admin

# Defina true se houver um proxy reverso (nginx, Traefik, Cloudflare) na frente da aplicação.
# Com false, a aplicação ignora cabeçalhos X-Forwarded-* (evita forjar o IP e driblar o limite de requisições).
SGI_REVERSE_PROXY=false
